// Type checking for the JavaScript the app still ships: the page scripts in src-tauri/src/page/
// and the removal window.
//
// Nothing is compiled and nothing is emitted: this reads api.js, uninstall-api.js and
// renderer/uninstall.js with the JSDoc they carry and says where the code and its own
// documentation disagree. page.d.ts says what bridge.js leaves on window for the first two.
//
// The page scripts stay JavaScript on purpose: the shell puts each one, as it is, behind bridge.js
// in the page's initialization script, and one that failed to load would leave the window with no
// window.api at all.
// The removal window is a classic script loaded without a build (vite.config.mjs says why), and
// renderer/uninstall-bridge.d.ts describes what uninstall-api.js gives it.
//
// Why these settings:
//   checkJs with strict off - the point is to catch what is wrong, not to fail on every value that
//     could be null in files that only pass messages through.
//   module preserve - each file is read the way it is written.
//   skipLibCheck - the dependencies' own .d.ts files are not this project's to fix.
//
// The rest of renderer/ is TypeScript with a tsconfig of its own. Not covered: tools/, a mix of both
// module systems that needs its own settings.
{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": false
  },
  "include": ["src-tauri/src/page/api.js", "src-tauri/src/page/uninstall-api.js", "src-tauri/src/page/page.d.ts", "renderer/uninstall.js", "renderer/uninstall-bridge.d.ts"]
}
