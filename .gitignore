node_modules/
dist/

# Astro's generated types and content cache: rebuilt on every build.
.astro/

# Throwaway Dota tree and downloaded mods built by tools/dev/sandbox.js. The list of what a
# sandbox should hold travels with the repo in tools/dev/sandbox-mods.json; the files do not.
sandbox/

# The weekly search report is a build product: it is posted as an issue comment, not kept.
seo-report.md

# Bookkeeping the scheduled jobs keep for themselves, and nothing else reads.
#
# These were committed back to main after every run, which is how a source repository ends up
# 57 MB: fingerprints.state.json alone is 434 KB and had been rewritten 66 times, 23.6 MB of
# history for a file whose only reader is the job that wrote it. They live in the Actions cache
# now. Every one of the three tools already treats a missing state file as "first run", so a
# cache that expires costs one slower run and nothing else.
fingerprints.state.json
# Written next to them by the same job and published to the catalog-data branch only.
mod-paths.json
indexnow.state.json
seo-state.json

# The catalog download counter's token, written into a release build by tools/release/stats-token.mjs
# from a repository secret. A copy in git would hand it to every scraper.
build/stats/download-stats.token

# The catalog uploader's token, encrypted into a release build by tools/release/uploader-token.mjs from a
# repository secret. A copy in git would hand every scraper a write key, even if it is encrypted.
# The name is deliberately quiet so it does not stand out in an unpacked app.
build/stats/uploader-token.bin

# Signing keys. The public halves are pinned in crates/mm-core/src/; the private halves live outside this
# tree and a stray one committed here would look like protection while being the opposite.
*.pem
catalog-key.pem
# written by tools/ops/check-credentials.mjs in radar.yml
credentials-status.json
# screenshots, window results and the app log of tools/dev/e2e.mjs
e2e-output/
# inputs tools/dev/fuzz-parsers.mjs kept because a parser mishandled them; the seed reproduces them
fuzz-output/

# The window page Vite builds (tools/dev/ui-build.mjs); the Tauri shell embeds it from here.
out/
# pictures and failure shots of the site tests (site/test, site/tools/look.mjs)
test-output/

# small copies of the mod pictures, kept between local builds (site/tools/thumbs.mjs)
.thumb-cache/
/work/

# The Rust build (Cargo.toml) and what tauri-build generates beside the shell's sources.
target/
src-tauri/gen/
