{
  // Community presets. See worker.mjs for what it does and README.md for how it is set up.
  "$schema": "../../site/node_modules/wrangler/config-schema.json",
  "name": "d2mm-presets",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  "routes": [{ "pattern": "presets.dota2modmanager.com", "custom_domain": true }],
  "vars": {
    "REPO": "dota2modmanager/dota2-mod-manager",
    "BRANCH": "community-presets",
    "WORKFLOW": "community-presets.yml"
  },
  "observability": { "enabled": true }
  // GITHUB_TOKEN, SESSION_SECRET, USER_SECRET and SIGNING_KEY are secrets: npx wrangler secret put GITHUB_TOKEN
}
