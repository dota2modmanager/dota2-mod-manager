---
/**
 * The shell every page sits in: head tags, header, footer.
 *
 * What it exists to get right is the part nobody sees. A two-language site that does not
 * declare its pairs is two sites competing with each other in search results, so every page
 * states its canonical address and both alternates, and x-default points at English.
 *
 * The header names the three places a visitor goes (the catalog, the heroes, the guides) and the
 * one thing they came for (Download). On a phone the three go behind a menu button, because a
 * sticky header two rows tall was a fifth of the screen on every page.
 */
import fs from 'node:fs';
import { join } from 'node:path';
import { langFromUrl, useTranslations, pathIn, type Lang } from '../i18n/ui';
import { ogPath } from '../lib/og';
import { SITE_ROOT } from '../lib/paths';
import { LANG_OFFER } from '../lib/inline-scripts';
import Backdrop from '../components/Backdrop.astro';
import onestLatin from '../../node_modules/@fontsource-variable/onest/files/onest-latin-wght-normal.woff2?url';
import onestCyr from '../../node_modules/@fontsource-variable/onest/files/onest-cyrillic-wght-normal.woff2?url';
import unboundedLatin from '../../node_modules/@fontsource-variable/unbounded/files/unbounded-latin-wght-normal.woff2?url';
import unboundedCyr from '../../node_modules/@fontsource-variable/unbounded/files/unbounded-cyrillic-wght-normal.woff2?url';
import '../styles/fonts.css';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
  /** Path without a language prefix, e.g. "/docs/quick-start/". */
  path: string;
  /** Overrides the drawn card, for pages that have a real picture of their own. */
  image?: { src: string; width: number; height: number };
  /** The page for an address that is not here: no canonical address of its own, no twin in the
      other language, and the language switch goes to the other language's front page. */
  lost?: boolean;
}

const { title, description, path, image, lost = false } = Astro.props;
const lang: Lang = langFromUrl(Astro.url);
const t = useTranslations(lang);

const site = Astro.site ?? new URL('https://dota2modmanager.com');
const canonical = new URL(pathIn(lang, path), site).href;
const alternates = [
  { hreflang: 'en', href: new URL(pathIn('en', path), site).href },
  { hreflang: 'ru', href: new URL(pathIn('ru', path), site).href },
  { hreflang: 'x-default', href: new URL(pathIn('en', path), site).href },
];
const other: Lang = lang === 'ru' ? 'en' : 'ru';
/* the offer of this page in the other language is worded in that language */
const offer = useTranslations(other);

/* This page's own link-preview card, drawn by tools/og.mjs and committed under public/og/.
   A page with a real picture of its own passes one instead - a hero page sends the art rather
   than a card with the hero's name set in type. Anything with neither falls back to the front
   page's card rather than pointing at a 404: an og:image that does not resolve is a link with
   no picture at all. The folder is looked up from the site root, not from this file (see
   lib/paths.ts for what that cost). */
const card = ogPath(lang, path);
const drawn = fs.existsSync(join(SITE_ROOT, 'public', card)) ? card : ogPath(lang, '/');
const ogImage = image?.src ?? drawn;
const ogSize = image ? { w: image.width, h: image.height } : { w: 1200, h: 630 };

const GITHUB = 'https://github.com/dota2modmanager/dota2-mod-manager';
const DISCORD = 'https://discord.gg/PBvG8D9MxT';

/* Which part of the site this page is in, for the header's current-page mark. */
const section = path.startsWith('/catalog/') || path.startsWith('/mods/') ? 'catalog' : path.startsWith('/heroes/') ? 'heroes' : path.startsWith('/docs/') ? 'docs' : '';
const navLinks = [
  { id: 'catalog', href: pathIn(lang, '/catalog/'), label: t('nav.catalog'), note: t('menu.catalog') },
  { id: 'heroes', href: pathIn(lang, '/heroes/'), label: t('nav.heroesShort'), note: t('menu.heroes') },
  { id: 'docs', href: pathIn(lang, '/docs/'), label: t('nav.guides'), note: t('menu.guides') },
];
const fonts = lang === 'ru' ? [onestCyr, unboundedCyr] : [onestLatin, unboundedLatin];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!lost && <link rel="canonical" href={canonical} />}
    {!lost && alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

    {/* The two files the first screen is set in, asked for before the stylesheet names them. */}
    {fonts.map((f) => <link rel="preload" href={f} as="font" type="font/woff2" crossorigin />)}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t('site.name')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, site).href} />
    <meta property="og:image:width" content={String(ogSize.w)} />
    <meta property="og:image:height" content={String(ogSize.h)} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'ru' ? 'en_US' : 'ru_RU'} />
    <meta name="twitter:card" content="summary_large_image" />

    {/* Google asks for a square favicon that is a multiple of 48px and fetches /favicon.ico as
        well as whatever is declared here. Generated by tools/icons.mjs from the app's own icon. */}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/icon-96.png" type="image/png" sizes="96x96" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/icon-180.png" />
    <meta name="robots" content={lost ? 'noindex' : 'max-image-preview:large'} />
    <meta name="theme-color" content="#141218" />
    {/* The rainbow somebody earned in the hunt follows them from page to page, and is put on
        before the first paint so the page does not flash purple first (Hunt.astro). */}
    <script is:inline>try{if(localStorage.getItem('mm-rainbow')==='1')document.documentElement.classList.add('rainbow')}catch(e){}</script>
    <slot name="head" />
  </head>
  <body>
    <Backdrop />
    <a class="skip" href="#main">Skip to content</a>

    {/* This page in the other language, offered in that language to a browser that reads it:
        an English page to a browser that prefers Russian, a Russian page to one that has no
        Russian at all. Never a redirect, which would send a search engine and a shared link to a
        page nobody asked for. The script below decides before the first paint, so nothing moves;
        any choice (this link, the close button, any language switch on the site) is kept, and
        the offer is not made again. */}
    {!lost && (
      <div class="langbar" id="langbar" lang={other} hidden>
        <div class="wrap langbar-row">
          <p>{offer('lang.offer')} <a href={pathIn(other, path)} hreflang={other}>{offer('lang.offerOpen')}</a></p>
          <button class="icon-btn langbar-x" type="button" data-lang-stay aria-label={offer('lang.offerClose')}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
          </button>
        </div>
      </div>
    )}
    <script is:inline set:html={LANG_OFFER} />

    <header class="topbar">
      <div class="wrap bar">
        <a class="brand" href={pathIn(lang, '/')}>
          <img class="brand-mark" src="/icon.png" width="30" height="30" alt="" />
          <span>{t('site.name')}</span>
        </a>
        <nav class="nav" aria-label={t('foot.nav')}>
          {navLinks.map((l) => <a href={l.href} aria-current={section === l.id ? 'page' : undefined}>{l.label}</a>)}
          <span class="nav-sep" aria-hidden="true"></span>
          <a href={GITHUB} rel="noopener">{t('nav.github')}</a>
          <a href={DISCORD} rel="noopener">{t('nav.discord')}</a>
          <a class="lang" href={pathIn(other, lost ? '/' : path)} lang={other} hreflang={other}>{t('lang.switch')}</a>
        </nav>
        {/* Two, and the stylesheet shows one. A phone or a tablet cannot run the app, and its
            visitor most likely came from a link in Discord to look at mods, so a touch screen gets
            the catalog; a computer gets the download. */}
        <a class="btn sm cta cta-download" href={`${pathIn(lang, '/')}#download`}>{t('nav.download')}</a>
        <a class="btn sm cta cta-catalog" href={pathIn(lang, '/catalog/')}>{t('nav.catalog')}</a>
        <button class="icon-btn menu-btn" type="button" aria-expanded="false" aria-controls="menu" aria-label={t('menu.open')}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path class="m1" d="M4 7h16" /><path class="m2" d="M4 12h16" /><path class="m3" d="M4 17h16" /></svg>
        </button>
      </div>
      <div class="menu" id="menu" hidden>
        <nav aria-label={t('menu.open')}>
          {navLinks.map((l) => <a href={l.href}>{l.label}<small>{l.note}</small></a>)}
          <div class="menu-foot">
            <a href={GITHUB} rel="noopener">{t('nav.github')}</a>
            <a href={DISCORD} rel="noopener">{t('nav.discord')}</a>
            <a href={pathIn(other, lost ? '/' : path)} lang={other} hreflang={other}>{t('lang.switch')}</a>
          </div>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap">
        <div class="foot-grid">
          <div class="foot-about">
            <a class="brand" href={pathIn(lang, '/')}>
              <img class="brand-mark" src="/icon.png" width="30" height="30" alt="" />
              <span>{t('site.name')}</span>
            </a>
            <p>{t('foot.about')}</p>
            <p>
              {/* The space after the full stop is written out: Astro drops a line break between two
                  elements, and the line read "TheFleece.GPL-3.0" for as long as it was a line break. */}
              {t('foot.built')} <a href="https://github.com/TheFleece" rel="noopener">TheFleece</a>.{' '}
              <a href={GITHUB} rel="noopener">{t('foot.license')}</a>.
            </p>
          </div>
          <nav aria-label={t('foot.colMods')}>
            <h3>{t('foot.colMods')}</h3>
            <ul>
              <li><a href={pathIn(lang, '/catalog/')}>{t('nav.catalog')}</a></li>
              <li><a href={pathIn(lang, '/heroes/')}>{t('nav.heroes')}</a></li>
              <li><a href={`${pathIn(lang, '/')}#download`}>{t('nav.download')}</a></li>
            </ul>
          </nav>
          <nav aria-label={t('foot.colLearn')}>
            <h3>{t('foot.colLearn')}</h3>
            <ul>
              <li><a href={pathIn(lang, '/docs/')}>{t('nav.guides')}</a></li>
              <li><a href={pathIn(lang, '/facts/')}>{t('nav.facts')}</a></li>
              <li><a href={pathIn(lang, '/transparency/')}>{t('nav.transparency')}</a></li>
              <li><a href="https://dota2modmanager.betteruptime.com" rel="noopener">{t('nav.status')}</a></li>
            </ul>
          </nav>
          <nav aria-label={t('foot.colProject')}>
            <h3>{t('foot.colProject')}</h3>
            <ul>
              <li><a href={pathIn(lang, '/changes/')}>{t('nav.changes')}</a></li>
              <li><a href={GITHUB} rel="noopener">{t('nav.github')}</a></li>
              <li><a href={`${GITHUB}/releases`} rel="noopener">{t('foot.releases')}</a></li>
              <li><a href={DISCORD} rel="noopener">{t('nav.discord')}</a></li>
              <li><a href={pathIn(other, lost ? '/' : path)} lang={other} hreflang={other}>{t('lang.switch')}</a></li>
            </ul>
          </nav>
        </div>
        {/* The part a fan project owes the people whose work it stands on. Valve lets fan work
            use its game content on a non-commercial basis, and the art of a Workshop cosmetic
            belongs to whoever made it rather than to Valve, so both are named. The way to ask
            for something to be taken down is a link, not an address buried in a repository. */}
        <div class="foot-legal">
          <p>{t('foot.unofficial')}</p>
          <p>{t('foot.marks')}</p>
          <p>
            {t('foot.takedown.before')}<a href={DISCORD} rel="noopener">{t('nav.discord')}</a>{t('foot.takedown.after')}
          </p>
          {/* The policies, each a page built from the file the repository keeps (src/lib/legal.ts).
              The code signing policy is the page the SignPath Foundation asks a project to publish. */}
          <p class="foot-policies">
            <a href={pathIn(lang, '/privacy/')}>{t('foot.privacy')}</a>
            <a href={pathIn(lang, '/terms/')}>{t('foot.terms')}</a>
            <a href={pathIn(lang, '/code-signing/')}>{t('foot.codesigning')}</a>
          </p>
          <p class="foot-rainbow" hidden>
            <button class="clear-btn" type="button" id="rainbowSwitch" data-on={t('foot.rainbowOn')} data-off={t('foot.rainbowOff')}></button>
          </p>
        </div>
      </div>
      <p class="wordmark" aria-hidden="true">{t('site.name')}</p>
    </footer>
  </body>
</html>

<script>
  // The menu on a phone: one button, Escape closes it, and so does following a link in it.
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const menu = document.getElementById('menu');
  if (btn && menu) {
    const set = (open: boolean) => {
      menu.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
      document.documentElement.classList.toggle('menu-open', open);
    };
    btn.addEventListener('click', () => set(menu.hidden));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { set(false); btn.focus(); } });
    menu.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) set(false); });
    window.matchMedia('(min-width: 861px)').addEventListener('change', (m) => { if (m.matches) set(false); });
  }

  // Sections rise in once as they come into view. An observer adds a class, rather than the
  // browser driving it from the scroll position: Safari 26 is the first to run scroll-driven
  // animation, and the site stopped opening on iPhones with forty of them. Only what is below
  // the fold when the page loads is hidden first, so nothing on the first screen ever blinks,
  // and with no script at all everything is simply there.
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const items = [...document.querySelectorAll<HTMLElement>('.reveal')];
  if (!still && items.length && 'IntersectionObserver' in window) {
    const fold = window.innerHeight * 0.92;
    const below = items.filter((el) => el.getBoundingClientRect().top > fold);
    if (below.length) {
      document.documentElement.classList.add('reveal-armed');
      for (const el of items) if (!below.includes(el)) el.classList.add('in');
      const io = new IntersectionObserver((entries) => {
        for (const en of entries) {
          if (!en.isIntersecting) continue;
          en.target.classList.add('in');
          io.unobserve(en.target);
        }
      }, { rootMargin: '0px 0px -8% 0px' });
      // siblings that arrive together come in one after another, 60 ms apart
      for (const el of below) {
        const sibs = el.parentElement ? [...el.parentElement.children].filter((c) => c.classList.contains('reveal')) : [];
        const i = sibs.indexOf(el);
        if (i > 0) el.style.setProperty('--delay', `${Math.min(i, 6) * 60}ms`);
        io.observe(el);
      }
    }
  }

  // The rainbow's switch, shown to somebody who has earned it (Hunt.astro sets the flag).
  const sw = document.getElementById('rainbowSwitch') as HTMLButtonElement | null;
  const read = () => { try { return localStorage.getItem('mm-rainbow'); } catch { return null; } };
  if (sw && read() !== null) {
    const paint = () => {
      const on = document.documentElement.classList.contains('rainbow');
      sw.textContent = on ? sw.dataset.on! : sw.dataset.off!;
    };
    sw.parentElement!.hidden = false;
    paint();
    sw.addEventListener('click', () => {
      const on = !document.documentElement.classList.contains('rainbow');
      document.documentElement.classList.toggle('rainbow', on);
      try { localStorage.setItem('mm-rainbow', on ? '1' : '0'); } catch { /* private mode */ }
      paint();
    });
    document.addEventListener('mm-rainbow', paint);
  }
</script>
