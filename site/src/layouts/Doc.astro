---
/**
 * One documentation page.
 *
 * The blocks come from src/i18n/docs.ts as data rather than markup, so the same structure
 * serves both languages and a page cannot end up with a heading in English and a paragraph
 * in Russian. Links inside that copy are written as "~/docs/vpk/" and get their language
 * prefix here, which is the one thing a translator would otherwise get wrong every time.
 *
 * The structured data says TechArticle plus a breadcrumb on every page, a FAQPage where the
 * page has questions, and HowTo where it has numbered steps. Google has stopped showing rich
 * results for most of that, but the markup is what other engines and answer bots read, and
 * describing the page correctly costs nothing.
 */
import Base from './Base.astro';
import { pathIn, type Lang } from '../i18n/ui';
import { docs, docsIndex, docSlugs, type Doc, type DocSlug } from '../i18n/docs';
import { plainText } from '../lib/text';
import { authorNode, appVersion } from '../lib/schema';
import { siteStats } from '../lib/stats';
import { landing } from '../i18n/landing';
import { catalogCategories } from '../lib/catalog';
import { categoryText } from '../i18n/categories';
import { docShots } from '../i18n/doc-shots';
import { SITE_ROOT } from '../lib/paths';
import fs from 'node:fs';
import path from 'node:path';
import sharp from 'sharp';

interface Props {
  lang: Lang;
  slug: DocSlug;
}

const { lang, slug } = Astro.props;
const doc: Doc = docs[lang][slug];
const index = docsIndex[lang];

/** Last time somebody checked these pages against the game, unless the page names a later day of
    its own: a guide written after that check is not one that check covered. Shown, and given to
    crawlers. */
const UPDATED = doc.updated ?? '2026-09-04';

const site = Astro.site ?? new URL('https://dota2modmanager.com');
const abs = (p: string) => new URL(pathIn(lang, p), site).href;

/**
 * "~/docs/vpk/" -> "/docs/vpk/" in English, "/ru/docs/vpk/" in Russian, and any count written
 * as {mods} filled from the catalog.
 *
 * Guides quote numbers too, and a number typed into a guide is a number that will be wrong in
 * a month. Russian also wants the noun to agree with a figure nobody knows before the build,
 * so the agreeing forms come along with the digits.
 */
const stats = await siteStats();
const locale = lang === 'ru' ? 'ru-RU' : 'en-US';
const nf = new Intl.NumberFormat(locale);
const pr = new Intl.PluralRules(locale);
const agree = (n: number, forms: readonly [string, string, string]) => {
  const form = pr.select(n);
  return form === 'one' ? forms[0] : form === 'few' ? forms[1] : forms[2];
};
const catWords: Record<Lang, [string, string, string]> = {
  en: ['category', 'categories', 'categories'],
  ru: ['категории', 'категориях', 'категориях'],
};
const counts: Record<string, string> = {
  '{version}': appVersion(),
  '{mods}': nf.format(stats.mods),
  '{modsWord}': agree(stats.mods, landing[lang].statWords[0]),
  '{categories}': nf.format(stats.categories),
  '{categoriesWord}': agree(stats.categories, catWords[lang]),
};

const link = (html: string) => {
  let out = html.replaceAll('~/', lang === 'en' ? '/' : `/${lang}/`);
  for (const [key, value] of Object.entries(counts)) out = out.replaceAll(key, value);
  return out;
};

/** The catalog by category, biggest first, counted from the same merged list the catalog shows. */
const categories = catalogCategories.map((c) => [c.id === 'heroes' ? (lang === 'ru' ? 'Герои' : 'Heroes') : categoryText(lang, c.id).name, c.n] as const);

/* The app's own pictures (src/i18n/doc-shots.ts), each put under the steps of the section it
   belongs to, or under its first paragraph. A picture the build cannot find stops the build: a
   guide that says "here is the button" over an empty frame is worse than no picture. */
type Shown = Doc['blocks'][number] | { k: 'shot'; src: string; w: number; h: number; caption: string };
/** The block a section's picture goes under: its first steps, else its first paragraph. */
const anchorOf = (id: string): number => {
  const start = doc.blocks.findIndex((x) => x.k === 'h2' && x.id === id);
  if (start < 0) throw new Error(`${slug}: there is no section "${id}" for a picture to go in`);
  const next = doc.blocks.findIndex((x, i) => i > start && x.k === 'h2');
  const part = doc.blocks.slice(start + 1, next < 0 ? undefined : next);
  const at = part.findIndex((x) => x.k === 'steps');
  const para = part.findIndex((x) => x.k === 'p');
  return start + 1 + (at >= 0 ? at : Math.max(para, 0));
};
const pictures = await Promise.all((docShots[slug] ?? []).map(async (s) => {
  const src = `/guides/${s.shot}-${lang}.webp`;
  const file = path.join(SITE_ROOT, 'public', src);
  if (!fs.existsSync(file)) throw new Error(`${slug}: ${src} is missing; npm run guide-shots takes it`);
  const { width = 0, height = 0 } = await sharp(file).metadata();
  return { at: anchorOf(s.after), shot: { k: 'shot' as const, src, w: width, h: height, caption: s.caption[lang] } };
}));
const shown: Shown[] = doc.blocks.flatMap((b, i) => [b, ...pictures.filter((p) => p.at === i).map((p) => p.shot)]);
const zoomLabel = lang === 'ru' ? 'Открыть картинку крупно' : 'Open the picture full size';

/** The page's own sections, for the contents beside it on a wide window. */
const toc = doc.blocks.filter((b): b is { k: 'h2'; id: string; t: string } => b.k === 'h2' && !!(b as { id?: string }).id);
const tocLabel = lang === 'ru' ? 'На этой странице' : 'On this page';

const steps = doc.blocks.filter((b) => b.k === 'steps');
const faqs = doc.blocks.filter((b) => b.k === 'faq');

const author = authorNode(site.origin);

const jsonLd: Record<string, unknown>[] = [
  { '@context': 'https://schema.org', ...author },
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: doc.h1,
    description: doc.description,
    inLanguage: lang,
    datePublished: UPDATED,
    dateModified: UPDATED,
    mainEntityOfPage: abs(`/docs/${doc.slug}/`),
    // One entity behind the site, the app and every guide, said once and pointed at from
    // here: a guide written by a name-shaped string is a guide by nobody in particular.
    author: { '@id': author['@id'] },
    publisher: { '@id': author['@id'] },
    isPartOf: { '@id': `${site.origin}/#website` },
    about: { '@type': 'VideoGame', name: 'Dota 2', publisher: { '@type': 'Organization', name: 'Valve Corporation' } },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Dota 2 Mod Manager', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: index.h1, item: abs('/docs/') },
      { '@type': 'ListItem', position: 3, name: doc.h1, item: abs(`/docs/${doc.slug}/`) },
    ],
  },
];

if (faqs.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.flatMap((b) =>
      b.items.map(([q, a]) => ({
        '@type': 'Question',
        name: plainText(q),
        acceptedAnswer: { '@type': 'Answer', text: plainText(a) },
      })),
    ),
  });
}

if (steps.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: doc.h1,
    description: doc.description,
    inLanguage: lang,
    step: steps[0].items.map(([name, text], i) => ({
      '@type': 'HowToStep',
      position: i + 1,
      name: plainText(name),
      text: plainText(text),
    })),
  });
}

/**
 * Three more, taken from where this one sits in the list and wrapping round.
 *
 * It used to be every other page, which was fine at five and a wall at twelve. Three is a row,
 * and walking forward from here means a reader who follows them lands somewhere new each time
 * instead of on the same first three from every page.
 */
const at = docSlugs.indexOf(slug);
const others = [1, 2, 3].map((n) => docs[lang][docSlugs[(at + n) % docSlugs.length]]);

const backLabel = lang === 'ru' ? 'Все гайды' : 'All guides';
const updatedLabel = lang === 'ru' ? 'Проверено' : 'Checked';
const nextLabel = lang === 'ru' ? 'Дальше' : 'Read next';
const updatedHuman = new Intl.DateTimeFormat(lang === 'ru' ? 'ru-RU' : 'en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(new Date(UPDATED));
---

{/* No brand suffix here. A guide competes on the question somebody typed, and " - Dota 2 Mod
    Manager" costs twenty characters that push the answer past where search results cut the
    line. The landing and the guides index carry the name; these carry the question. */}
<Base title={doc.title} description={doc.description} path={`/docs/${doc.slug}/`}>
  {jsonLd.map((node) => <script type="application/ld+json" slot="head" set:html={JSON.stringify(node)} />)}

  <div class="wrap doc-layout">
  <article class="doc">
    <nav class="crumbs" aria-label={index.h1}>
      <a href={pathIn(lang, '/docs/')}>{backLabel}</a>
    </nav>

    <h1>{doc.h1}</h1>
    <p class="lead">{doc.lead}</p>
    <p class="muted doc-date">
      {updatedLabel} <time datetime={UPDATED}>{updatedHuman}</time>
    </p>

    {
      shown.map((b) => {
        if (b.k === 'shot')
          return (
            <figure class="doc-shot">
              <a href={b.src} data-zoom title={zoomLabel}>
                <img src={b.src} width={b.w} height={b.h} alt={b.caption} loading="lazy" decoding="async" />
              </a>
              <figcaption>{b.caption}</figcaption>
            </figure>
          );
        if (b.k === 'h2') return <h2 id={b.id}>{b.t}</h2>;
        if (b.k === 'p') return <p set:html={link(b.t)} />;
        if (b.k === 'note') return <p class="doc-note" set:html={link(b.t)} />;
        if (b.k === 'code') return <pre class="doc-code" tabindex="0"><code>{b.t}</code></pre>;
        if (b.k === 'categories')
          return (
            <ul class="facts">
              {categories.map(([label, n]) => (
                <li>
                  <b>{label}</b>
                  <span>{nf.format(n)}</span>
                </li>
              ))}
            </ul>
          );
        if (b.k === 'list')
          return (
            <ul class="doc-list">
              {b.items.map((it) => (
                <li set:html={link(it)} />
              ))}
            </ul>
          );
        if (b.k === 'steps')
          return (
            <ol class="doc-steps">
              {b.items.map(([title, text]) => (
                <li>
                  <b>{title}</b>
                  <span set:html={link(text)} />
                </li>
              ))}
            </ol>
          );
        if (b.k === 'cards')
          return (
            <div class="cards doc-cards">
              {b.items.map(([title, text]) => (
                <div class="card">
                  <h3>{title}</h3>
                  <p set:html={link(text)} />
                </div>
              ))}
            </div>
          );
        return (
          <dl class="doc-faq">
            {b.items.map(([q, a]) => (
              <>
                <dt>{q}</dt>
                <dd set:html={link(a)} />
              </>
            ))}
          </dl>
        );
      })
    }

    <aside class="doc-next">
      <h2>{nextLabel}</h2>
      <div class="cards">
        {
          others.map((o) => (
            <a class="card doc-card-link" href={pathIn(lang, `/docs/${o.slug}/`)}>
              <h3>{o.h1}</h3>
              <p>{o.card}</p>
            </a>
          ))
        }
      </div>
    </aside>
  </article>
  {toc.length > 2 && (
    <nav class="toc" aria-label={tocLabel}>
      <b>{tocLabel}</b>
      <ol>
        {toc.map((h) => <li><a href={`#${h.id}`}>{h.t}</a></li>)}
      </ol>
    </nav>
  )}
  </div>
  {pictures.length > 0 && (
    <dialog class="zoom" id="zoom" aria-label={zoomLabel}></dialog>
  )}
</Base>

<script>
  // A picture of the app opens full size over the page: in the reading column a whole window is
  // too small to read. Any press, or Escape, closes it. A click that asks for a new tab still
  // opens the file there.
  const zoom = document.getElementById('zoom') as HTMLDialogElement | null;
  if (zoom) {
    document.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-zoom]');
      if (!a || e.ctrlKey || e.metaKey || e.shiftKey || e.button !== 0) return;
      e.preventDefault();
      // the picture is made here, so the page carries no empty one for a reader to stumble on
      const img = a.querySelector('img')!;
      const big = new Image(img.naturalWidth || img.width, img.naturalHeight || img.height);
      big.src = a.href;
      big.alt = img.alt;
      zoom.replaceChildren(big);
      zoom.showModal();
    });
    zoom.addEventListener('click', () => zoom.close());
  }
</script>

<script>
  // The contents mark the section being read: the last heading that has scrolled past the top.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
  if (links.length) {
    const heads = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1)))).filter(Boolean) as HTMLElement[];
    let queued = false;
    const mark = () => {
      queued = false;
      const line = 120;
      let at = 0;
      heads.forEach((h, i) => { if (h.getBoundingClientRect().top < line) at = i; });
      links.forEach((a, i) => a.classList.toggle('on', i === at));
    };
    window.addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(mark); } }, { passive: true });
    mark();
  }
</script>
