---
import Base from '../../../layouts/Base.astro';
import ModPage from '../../../components/ModPage.astro';
import { catalog } from '../../../lib/catalog';
import { modText } from '../../../lib/mods';
import { modSchema } from '../../../lib/schema';

export function getStaticPaths() {
  return catalog.map((mod) => ({ params: { key: mod.key }, props: { mod } }));
}

const { mod } = Astro.props;
const text = modText('ru', mod);
const jsonLd = modSchema('ru', mod);
const img = mod.looks.find((l) => l.img)?.img;
---

<Base title={text.title} description={text.description} path={`/mods/${mod.key}/`} image={img ? { src: img, width: 854, height: 480 } : undefined}>
  {jsonLd.map((node) => <script type="application/ld+json" slot="head" set:html={JSON.stringify(node)} />)}
  <ModPage lang="ru" mod={mod} />
</Base>
