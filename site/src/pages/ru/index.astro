---
import Base from '../../layouts/Base.astro';
import Landing from '../../components/Landing.astro';
import { landingSchema } from '../../lib/schema';

/*
 * The Russian title and description carry the words a Russian actually types.
 *
 * They did not before, and that was the whole reason this page was nowhere on the query
 * "дота 2 мод менеджер": across 5,333 words of Russian the site said "менеджер" three times
 * and never wrote "Дота" in a title, a heading or an alt at all. The brand stays first,
 * because the brand is what Google reads as the name of the site.
 */
const description = 'Бесплатный менеджер модов и инструмент для моддинга Доты 2: 1000+ модов в один клик, любой предмет на любого героя с 3D-просмотром, редакторы эффектов и HUD, сборки ссылкой.';

const jsonLd = landingSchema('ru');
---

<Base
  title="Dota 2 Mod Manager - мод-менеджер для Доты 2: моды, конструктор предметов, инструменты"
  description={description}
  path="/"
>
  {jsonLd.map((node) => <script type="application/ld+json" slot="head" set:html={JSON.stringify(node)} />)}
  <Landing lang="ru" />
</Base>
