---
import Base from '../../layouts/Base.astro';
import Legal from '../../components/Legal.astro';
import { fromMarkdown } from '../../lib/legal';
import * as source from '../../../../docs/PRIVACY.ru.md';

const doc = fromMarkdown(await source.compiledContent(), 'docs/PRIVACY.ru.md');
