---
import Base from '../../layouts/Base.astro';
import ModPage from '../../components/ModPage.astro';
import { catalog } from '../../lib/catalog';
import { modText } from '../../lib/mods';
import { modSchema } from '../../lib/schema';

export function getStaticPaths() {
  return catalog.map((mod) => ({ params: { key: mod.key }, props: { mod } }));
}

const { mod } = Astro.props;
const text = modText('en', mod);
const jsonLd = modSchema('en', mod);
const look = mod.looks.find((l) => l.img);
---

<Base title={text.title} description={text.description} path={`/mods/${mod.key}/`} image={look?.img ? { src: look.img, width: look.width, height: look.height } : undefined}>
  {jsonLd.map((node) => <script type="application/ld+json" slot="head" set:html={JSON.stringify(node)} />)}
  <ModPage lang="en" mod={mod} />
</Base>
