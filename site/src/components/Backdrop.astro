---
/**
 * What the page sits on: two soft pools of the app's purple at the top and a faint grid, both
 * fading out a screen down.
 *
 * It used to be busier: a canvas of drifting motes that the pointer stirred, and a glow that
 * followed the pointer around. Both went when the landing got the mod wall, which is the one
 * moving thing the page should have; two layers of light competing with two thousand pictures
 * of heroes is noise. The pools have no blur filter on them: the gradient is soft by itself,
 * and a 120 px blur on a 780 px circle is the kind of layer that made Safari give up on iPhones.
 *
 * Drawn rather than downloaded, because Dota's own artwork belongs to Valve.
 */
---

<div class="backdrop" aria-hidden="true">
  <div class="glow glow-a"></div>
  <div class="glow glow-b"></div>
  <div class="grid-lines"></div>
</div>

<style>
  .backdrop {
    position: fixed;
    inset: 0 0 auto 0;
    height: 120vh;
    z-index: -3;
    overflow: hidden;
    pointer-events: none;
    background: var(--surface);
  }
  .glow { position: absolute; border-radius: 50%; }
  .glow-a {
    width: 1000px; height: 1000px;
    top: -520px; left: 50%; margin-left: -820px;
    background: radial-gradient(circle, color-mix(in srgb, var(--primary) 26%, transparent) 0%, color-mix(in srgb, var(--primary) 9%, transparent) 32%, transparent 68%);
    opacity: 0.8;
  }
  .glow-b {
    width: 820px; height: 820px;
    top: -380px; left: 50%; margin-left: 120px;
    background: radial-gradient(circle, rgb(61 47 107 / 0.85) 0%, rgb(61 47 107 / 0.3) 32%, rgb(61 47 107 / 0) 68%);
  }
  .grid-lines {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(color-mix(in srgb, var(--primary) 5%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--primary) 5%, transparent) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(110% 55% at 50% 0%, #000 0%, transparent 70%);
    -webkit-mask-image: radial-gradient(110% 55% at 50% 0%, #000 0%, transparent 70%);
  }
</style>
