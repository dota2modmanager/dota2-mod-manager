---
/**
 * The catalog's categories, biggest first, plus the way into the hero pages.
 *
 * The one page on the site that answers "what kinds of mods even exist for Dota", which is the
 * question somebody has before they know what to search for.
 */
import { pathIn, type Lang } from '../i18n/ui';
import { categoryText } from '../i18n/categories';
import { categories, totalCategoryMods } from '../lib/categories';
import { heroes, totalHeroMods } from '../lib/heroes';
import { heroCopy } from '../i18n/heroes';

interface Props { lang: Lang }
const { lang } = Astro.props;

const nf = new Intl.NumberFormat(lang === 'ru' ? 'ru-RU' : 'en-US');
const ru = lang === 'ru';

const h1 = ru ? 'Каталог модов для Доты 2' : 'The Dota 2 mod catalog';
const lead = ru
  ? 'Что вообще бывает: ландшафты, деревья, река, шейдеры, курсоры, шрифты, фон меню, звуки, крипы и остальное. Всё из открытого каталога D2PFX и всё ставится в один клик.'
  : 'What exists, by kind: terrains, trees, the river, shaders, cursors, fonts, the menu background, sounds, creeps and the rest. All from the open D2PFX catalog, all installed in one click.';
// The second count is mods, and it says so: printed bare it read "Categories: 37 · 860".
const pr = new Intl.PluralRules(ru ? 'ru-RU' : 'en-US');
const modWord = (n: number) =>
  ru ? ({ one: 'мод', few: 'мода' } as Record<string, string>)[pr.select(n)] ?? 'модов' : n === 1 ? 'mod' : 'mods';
const heroesLine = ru
  ? `Скины на конкретного героя лежат отдельно: ${nf.format(heroes.length)} героев, ${nf.format(totalHeroMods)} модов.`
  : `Skins for a particular hero have their own pages: ${nf.format(heroes.length)} heroes, ${nf.format(totalHeroMods)} mods.`;
---

<article class="doc wrap">
  <h1>{h1}</h1>
  <p class="lead">{lead}</p>
  <p class="muted">
    {ru ? 'Категорий' : 'Categories'}: {nf.format(categories.length)} · {nf.format(totalCategoryMods)} {modWord(totalCategoryMods)}
  </p>

  <ul class="hero-links hero-grid">
    {
      categories.map((c) => (
        <li>
          <a class="chip" href={pathIn(lang, `/catalog/${c.id}/`)}>
            {categoryText(lang, c.id).name} <span>{nf.format(c.mods.length)}</span>
          </a>
        </li>
      ))
    }
  </ul>

  <h2>{heroCopy[lang].indexH1}</h2>
  <p>
    {heroesLine} <a href={pathIn(lang, '/heroes/')}>{heroCopy[lang].back}</a>.
  </p>
</article>
