---
/**
 * The screenshots: one at a time, at full size, and you choose which.
 *
 * This started as three pictures down the page, then became a fanned deck that advanced on
 * its own. The deck looked like a deck in the sketch and like a layout bug on the screen: the
 * cards behind the front one ran off the left and right edges by different amounts, which is
 * what an accident looks like. Asymmetry reads as a mistake because it usually is one.
 *
 * The auto-advance had to go regardless of how it looked. Carousels that move by themselves
 * are one of the better-documented losers in interface research: they take fewer looks and
 * fewer clicks than the same content standing still, almost nobody reaches the second slide,
 * and anyone slow with a pointer is fighting the page. This is a product page - the screens
 * are the argument, not the decoration - so the visitor picks which one to look at and it
 * stays there until they say otherwise.
 *
 * What is left is a real tab list: arrow keys, Home and End, one stop in the tab order, and
 * the panel labelled by its tab. None of that had to be built - it is what the role is for.
 *
 * There is no title bar drawn around the picture, and that is the second thing this went
 * through. Drawing browser chrome around a desktop application would be a lie about the
 * product, and macOS traffic lights would be a lie about the platform as well as the surest
 * sign the frame came out of a mockup generator - so the first attempt drew a Windows one.
 * Then it went on screen: the app has its own title bar, it is in the screenshot, and the
 * page had put a second one above it. What was left was worth keeping on its own - the small
 * radius, the lit top edge, the layered shadow - so the frame stayed and the bar went.
 */
import type { Lang } from '../i18n/ui';
import { SHOT_SIZE, srcsetFor } from '../lib/media';

interface Props {
  lang: Lang;
  shots: Array<{ src: string; caption: string; alt: string; label: string }>;
  /** Accessible name for the tab list, e.g. "Screens of the app". */
  tablist: string;
}
const { shots, tablist } = Astro.props;
---

<div class="tour" id="tour">
  <div class="tour-tabs" role="tablist" aria-label={tablist}>
    {shots.map((s, i) => (
      <button
        class="tour-tab"
        type="button"
        role="tab"
        id={`tour-tab-${i}`}
        aria-controls={`tour-panel-${i}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
      >{s.label}</button>
    ))}
  </div>

  {/* the tab panel is a <div> holding the <figure>: a figure may not take the tabpanel role */}
  {shots.map((s, i) => (
    <div
      class="tour-panel"
      role="tabpanel"
      id={`tour-panel-${i}`}
      aria-labelledby={`tour-tab-${i}`}
      hidden={i !== 0}
    >
     <figure>
      <div class="win">
        <img
          src={s.src}
          srcset={srcsetFor(s.src, SHOT_SIZE.width)}
          {/* the window is the column width on a phone and never wider than the shot itself */}
          sizes={`(max-width: 900px) 92vw, ${SHOT_SIZE.width}px`}
          width={SHOT_SIZE.width}
          height={SHOT_SIZE.height}
          loading={i === 0 ? 'eager' : 'lazy'}
          decoding="async"
          fetchpriority={i === 0 ? 'high' : undefined}
          alt={s.alt}
        />
        <div class="sheen"></div>
      </div>
      <figcaption>{s.caption}</figcaption>
     </figure>
    </div>
  ))}
</div>

<script>
  const tour = document.getElementById('tour');

  if (tour) {
    const tabs = [...tour.querySelectorAll<HTMLElement>('[role="tab"]')];
    const panels = [...tour.querySelectorAll<HTMLElement>('[role="tabpanel"]')];

    // Roving tabindex: the tab list is one stop on the way through the page, and the arrows
    // move between the tabs inside it. Tabbing through three buttons to get past three
    // pictures is what a tab list exists to avoid.
    const select = (n: number, focus = true) => {
      const at = (n + tabs.length) % tabs.length;
      tabs.forEach((t, i) => {
        t.setAttribute('aria-selected', String(i === at));
        t.tabIndex = i === at ? 0 : -1;
      });
      panels.forEach((p, i) => { p.hidden = i !== at; });
      if (focus) tabs[at].focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i, false));
      tab.addEventListener('keydown', (e) => {
        const go = { ArrowLeft: i - 1, ArrowRight: i + 1, Home: 0, End: tabs.length - 1 }[e.key];
        if (go === undefined) return;
        e.preventDefault();
        select(go);
      });
    });

    // Light on the glass, following the pointer. A round pool has no edge anywhere; the band
    // this replaced had two, and drew a diagonal seam straight across the screenshot.
    if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      let queued = false;
      let ev: PointerEvent | null = null;
      const move = () => {
        queued = false;
        if (!ev) return;
        const win = (ev.target as HTMLElement).closest<HTMLElement>('.win');
        if (!win) return;
        const box = win.getBoundingClientRect();
        win.style.setProperty('--sx', `${((ev.clientX - box.left) / box.width) * 100}%`);
        win.style.setProperty('--sy', `${((ev.clientY - box.top) / box.height) * 100}%`);
      };
      tour.addEventListener('pointermove', (e) => {
        ev = e;
        if (!queued) { queued = true; requestAnimationFrame(move); }
      }, { passive: true });
    }
  }
</script>
