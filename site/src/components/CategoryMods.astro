---
/**
 * One category of the catalog: every mod in it, as a grid that can be searched and sorted.
 *
 * Who arrives here is somebody searching how to change the river, who will only learn the word
 * "mod" from reading this. So the paragraph under the heading says what this kind of mod does
 * before the pictures start, and the install section does not assume they have the app.
 *
 * Every card is in the HTML (Browser.astro, page mode), so the page reads whole to a search
 * engine; the script only sorts and filters what is there. It used to be one wide card per row,
 * which for 154 hero items was a page as long as a novel.
 */
import { pathIn, type Lang } from '../i18n/ui';
import { categoryText } from '../i18n/categories';
import { heroCopy } from '../i18n/heroes';
import { otherCategories, type Category } from '../lib/categories';
import { catalog, groupOf } from '../lib/catalog';
import Browser from './Browser.astro';

interface Props { lang: Lang; category: Category }
const { lang, category } = Astro.props;

const c = categoryText(lang, category.id);
const h = heroCopy[lang];
const nf = new Intl.NumberFormat(lang === 'ru' ? 'ru-RU' : 'en-US');
const pr = new Intl.PluralRules(lang === 'ru' ? 'ru-RU' : 'en-US');
const word = (n: number) => {
  const f = pr.select(n);
  return f === 'one' ? h.modsWord[0] : f === 'few' ? h.modsWord[1] : h.modsWord[2];
};

const link = (s: string) => s.replaceAll('~/', lang === 'en' ? '/' : `/${lang}/`);
const others = otherCategories(category.id);
const mods = catalog.filter((m) => m.cat === category.id);
const cover = mods.find((m) => m.img)?.img;

const count = nf.format(mods.length);
const intro =
  lang === 'ru'
    ? `В каталоге D2PFX <b>${count} ${word(mods.length)}</b> в этой категории. Каждый меняет картинку только у тебя на экране: соперники и союзники видят свою игру.`
    : `The D2PFX catalog has <b>${count} ${word(mods.length)}</b> in this category. Each changes what you see on your own screen; everyone else sees their own game.`;

const backLabel = lang === 'ru' ? 'Весь каталог' : 'The whole catalog';
const moreLabel = lang === 'ru' ? 'Другие категории' : 'Other categories';
const altFor = (m: { name: string }) => `${m.name}: ${c.name}, ${lang === 'ru' ? 'мод для Доты 2' : 'a Dota 2 mod'}`;
---

<header class="page-hero" data-group={groupOf(category.id)}>
  {cover && <img src={cover} width="854" height="480" alt="" fetchpriority="high" />}
  <div class="wrap">
    <nav class="crumbs" aria-label={backLabel}>
      <a href={pathIn(lang, '/catalog/')}>{backLabel}</a>
    </nav>
    <h1>{c.h1}</h1>
    {c.about && <p class="lead">{c.about}</p>}
    <p class="prose" set:html={intro} />
  </div>
</header>

<div class="wrap">
  <Browser lang={lang} mode="page" mods={mods} context="category" altFor={altFor} />

  <div class="doc prose-block">
    <h2 id="install">{h.install}</h2>
    <p set:html={link(h.installBody)} />
  </div>

  <aside class="doc-next">
    <h2>{moreLabel}</h2>
    <ul class="hero-links">
      {others.map((o) => (
        <li>
          <a class="chip" href={pathIn(lang, `/catalog/${o.id}/`)} data-group={groupOf(o.id)}>
            <span class="dot"></span>{categoryText(lang, o.id).name} <small>{nf.format(o.mods.length)}</small>
          </a>
        </li>
      ))}
    </ul>
  </aside>
</div>
