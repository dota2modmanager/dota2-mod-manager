---
/**
 * Twenty-four seconds of the app doing the thing the page is about.
 *
 * It is not a screen recording somebody made by hand: the app is driven by a script and the
 * window is filmed by the app itself (tools/screencast.js), so the day the interface changes
 * the clip is re-shot by running one command. That is why it can afford to be specific -
 * a real hero, a real set, a real install - instead of a montage that ages badly.
 *
 * How it loads, which is most of the work:
 *
 * `preload="none"` and no `autoplay` attribute. The default preload is `metadata`, which
 * fetches enough of the file to undo the point of not loading it, and an `autoplay` attribute
 * starts that fetch the moment the page parses, three screens before anybody sees it.
 * Playback starts when the clip comes into view and stops when it leaves.
 *
 * It stays a poster on a narrow screen. Nearly three megabytes is a fine trade on a desktop
 * connection and a poor one on a phone, so a phone gets the still and a button.
 *
 * Same for anybody who asked for less motion: the still, and a way to play it deliberately.
 * A clip that starts moving by itself is exactly what that setting is about.
 */
import type { Lang } from '../i18n/ui';
import { tourUrl, tourPoster, tourText, TOUR_SIZE } from '../lib/media';

interface Props {
  lang: Lang;
  title: string;
  caption: string;
  play: string;
}
const { lang, title, caption, play } = Astro.props;
const film = tourText[lang];
---

<section class="tour-film">
  <div class="wrap">
    <h2 class="reveal">{title}</h2>
    <figure class="film reveal">
      <div class="win">
        <video
          id="film"
          width={TOUR_SIZE.width}
          height={TOUR_SIZE.height}
          poster={tourPoster(lang)}
          muted
          loop
          playsinline
          preload="none"
          data-src={tourUrl(lang)}
          title={film.name}
          aria-label={caption}
        ></video>
        <button class="film-play" id="filmPlay" type="button" hidden>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
          {play}
        </button>
      </div>
      <figcaption>{caption}</figcaption>
    </figure>
  </div>
</section>

<script>
  const film = document.getElementById('film') as HTMLVideoElement | null;
  const play = document.getElementById('filmPlay') as HTMLButtonElement | null;

  if (film && play) {
    const still = window.matchMedia('(prefers-reduced-motion: reduce)');
    // Wide enough that the file is a reasonable thing to send, which is the only question a
    // phone is really asking here.
    const roomy = window.matchMedia('(min-width: 760px)');
    const auto = () => !still.matches && roomy.matches;

    // The file is named in data-src and handed over only here. A <source> in the markup, even
    // with preload="none", kept WebKit's load event from ever firing: Safari sat on a page that
    // had finished drawing and still called itself loading. A phone never plays the clip by
    // itself, so on a phone it is fetched only when somebody presses play.
    const start = () => {
      if (!film.src && film.dataset.src) { film.src = film.dataset.src; film.preload = 'auto'; }
      film.play().catch(() => { play.hidden = false; });
    };

    play.addEventListener('click', () => {
      play.hidden = true;
      film.controls = true;
      start();
    });

    const io = new IntersectionObserver((entries) => {
      for (const en of entries) {
        if (!auto()) { play.hidden = false; film.pause(); continue; }
        if (en.isIntersecting) start();
        else film.pause();
      }
    }, { threshold: 0.3 });

    io.observe(film);
    if (!auto()) play.hidden = false;
    still.addEventListener('change', () => { play.hidden = auto(); if (!auto()) film.pause(); });
  }
</script>
