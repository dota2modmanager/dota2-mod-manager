---
/**
 * The landing, in whichever language the page asked for.
 *
 * The page opens with the product's name at full size rather than a sentence about it. That
 * is what the two sites in this corner of the internet that people actually like do, and it
 * is also the phrase somebody types into a search box. The sentence explaining it comes
 * second, where a sentence belongs.
 *
 * The numbers under it are the ones people read before they read anything, so the build counts
 * them from the catalog and the releases API rather than trusting anybody's memory: see
 * src/lib/stats.ts. A checkable number is the only kind worth printing.
 *
 * The order after that answers a stranger's questions in the order they ask them: what does
 * it look like, what does it do, why should I run an unsigned .exe, and the usual worries.
 */
import { landing } from '../i18n/landing';
import Download from './Download.astro';
import { siteStats } from '../lib/stats';
import { shotNames, shotUrl, shotAlt } from '../lib/media';
import Shots from './Shots.astro';
import Tour from './Tour.astro';
import Creator from './Creator.astro';
import Stand from './Stand.astro';
import Hunt from './Hunt.astro';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = landing[lang];

/** Copy links are written as "~/docs/safe/" and get their language prefix here, the same
    way the guides do, so one string serves both halves of the site. */
const link = (html: string) => html.replaceAll('~/', lang === 'en' ? '/' : `/${lang}/`);

/** "Free · open source · Windows and Linux" breaks at the dots and nowhere else. Left to itself a
    phone broke it inside "открытый код" or left "Linux" alone on the second line. */
const kicker = c.heroKicker.split(' · ');
const meta = c.heroMeta.split(' · ');
// the dot stays at the end of the line it closes, never at the start of the next one
const SEP = ' · ';

const GITHUB = 'https://github.com/dota2modmanager/dota2-mod-manager';
const RELEASES = `${GITHUB}/releases/latest`;
const WORKFLOW = `${GITHUB}/actions`;
const DISCORD = 'https://discord.gg/PBvG8D9MxT';

// The badge says which version is current, read at build time. If GitHub cannot be reached
// while building, the badge simply does not appear - a stale version number would be worse.
let latestTag: string | null = null;
try {
  const r = await fetch('https://api.github.com/repos/dota2modmanager/dota2-mod-manager/releases/latest', {
    headers: { 'User-Agent': 'dota2modmanager-site' },
  });
  if (r.ok) latestTag = (await r.json()).tag_name ?? null;
} catch { /* offline build: no badge */ }

const stats = await siteStats();
const nf = new Intl.NumberFormat(lang === 'ru' ? 'ru-RU' : 'en-US');
// Intl decides which plural form a number takes, so "1 мод", "22 мода" and "1090 модов" all
// come out right without anybody writing the rule down.
const plural = new Intl.PluralRules(lang === 'ru' ? 'ru-RU' : 'en-US');
const word = (n: number, forms: readonly [string, string, string]) => {
  const form = plural.select(n);
  return form === 'one' ? forms[0] : form === 'few' ? forms[1] : forms[2];
};

const heroLead = c.heroLead
  .replace('{mods}', nf.format(stats.mods))
  .replace('{word}', word(stats.mods, c.statWords[0]));

const tiles = [
  { n: stats.mods, forms: c.statWords[0], label: c.statLabels[0] },
  { n: stats.downloads, forms: c.statWords[1], label: c.statLabels[1] },
  { n: stats.releases, forms: c.statWords[2], label: c.statLabels[2] },
].map((t) => ({ value: nf.format(t.n), to: t.n, label: t.label.replace('{word}', word(t.n, t.forms)) }));
// The last tile is not a count of anything, so it has no number to climb to.
const statTiles = [...tiles, { value: '100%', to: 0, label: c.statLabels[3] }];

// The trust list claims the history is checkable, so its own figures are counted rather than
// typed: the pair sitting here said "27 releases, 17,500+ downloads" for long enough that the
// answer bots quoting this page were repeating a number two releases out of date.
const trustFacts = c.trustFacts.map(([title, body]) => [
  title
    .replace('{releases}', nf.format(stats.releases))
    .replace('{relWord}', word(stats.releases, c.statWords[2]))
    .replace('{downloads}', nf.format(stats.downloads))
    .replace('{dlWord}', word(stats.downloads, c.statWords[1])),
  body,
]);

// Sorted by what is actually in the catalog, so the band stays in order as it grows.
const marquee = c.marquee
  .map(([id, label]) => [label, stats.byCategory[id] ?? 0] as const)
  .filter(([, n]) => n > 0)
  .sort((a, b) => b[1] - a[1]);

// the app is bilingual, so the window in the picture speaks the reader's language
const captions = [c.shotCatalog, c.shotHeroes, c.shotLibrary];
const shots = shotNames.map((name, i) => ({
  src: shotUrl(lang, name),
  caption: captions[i],
  label: c.shotLabels[i],
  alt: shotAlt[lang][name],
}));
---

<section class="hero">
  <div class="wrap">
    {latestTag && (
      <a class="badge" href={RELEASES} rel="noopener">
        <span class="dot"></span>
        <b>{latestTag}</b>
        <span class="badge-sep"></span>
        <span>{c.latest}</span>
      </a>
    )}
    <p class="kicker">{kicker.map((part, i) => <>{i > 0 && SEP}<span class="nobr">{part}</span></>)}</p>
    <h1>
      <span class="t1">{c.heroTitle}</span>
      <span class="t2">{c.heroTitleAccent}</span>
    </h1>
    <p class="lead">{heroLead}</p>

    <div class="btn-row">
      <Download copy={c} anchor />
      <a class="btn ghost" href={GITHUB} rel="noopener">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.8 0-1.3.5-2.3 1.2-3.2-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.4 11.4 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.6 1.6.2 2.8.1 3.1.8.9 1.2 1.9 1.2 3.2 0 4.6-2.7 5.5-5.3 5.8.4.4.8 1.1.8 2.2v3.3c0 .4.2.7.8.6 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5z" />
        </svg>
        {c.source}
      </a>
    </div>
    <p class="muted">{meta.map((part, i) => <>{i > 0 && SEP}<span class="nobr">{part}</span></>)}</p>

    {/* No `reveal` here on purpose. A scroll-driven reveal reads the element's position in
        the viewport, and this row starts half in it - so it would sit permanently at a third
        of its opacity until somebody scrolled, which looks like a page that failed to load
        rather than like an entrance. Above the fold, things are simply there. */}
    <ul class="stats lit-group">
      {statTiles.map(({ value, to, label }) => {
        // A number worth counting up to is one that is large enough for the climb to mean
        // something. "29 releases" counting from zero is a parody of the effect, so only the
        // four-figure ones get it; the rest are simply printed.
        const climbs = to >= 1000;
        return (
          <li class="lit">
            <b data-to={climbs ? to : undefined} data-final={climbs ? value : undefined}>{value}</b>
            <span>{label}</span>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<Tour lang={lang} title={c.filmTitle} caption={c.filmCaption} play={c.filmPlay} />

<Creator lang={lang} />

<section class="shots">
  <div class="wrap">
    <h2 class="sr-only">{c.shotsTitle}</h2>
    <Shots lang={lang} shots={shots} tablist={c.shotsTablist} />
  </div>
</section>

<section>
  <div class="wrap">
    <h2 class="reveal">{c.whatTitle}</h2>
    <div class="cards lit-group">
      {/* set:html so a card can send you somewhere. The strings are ours, in src/i18n/landing.ts,
          and the only markup any of them carries is a link. Through link(), like every other
          block on the page: a card written with an absolute /docs/ path sent Russian readers
          to the English guide, which is exactly what the "~/" convention exists to stop. */}
      {c.cards.map(([title, body]) => (
        <article class="card lit reveal">
          <h3>{title}</h3>
          <p set:html={link(body)} />
        </article>
      ))}
    </div>
  </div>
</section>

{/* Straight after the card that claims the app tells you when mods collide. A claim followed
    by the thing itself, rather than by another claim. */}
<Stand
  title={c.standTitle}
  lead={c.standLead}
  slotsLabel={c.standSlots}
  emptyLabel={c.standEmpty}
  winsLabel={c.standWins}
  coveredLabel={c.standCovered}
  hint={c.standHint}
  moveLabel={c.standMove}
/>

<section class="trust">
  <div class="wrap">
    <h2 class="reveal">{c.trustTitle}</h2>
    <p class="lead reveal">{c.trustLead}</p>
    <ul class="facts">
      {trustFacts.map(([title, body]) => (
        <li class="reveal">
          <b>{title}</b>
          <span>{body}</span>
        </li>
      ))}
    </ul>
    <div class="warn reveal">
      <h3>{c.smartscreenTitle}</h3>
      <p set:html={c.smartscreen} />
      <p class="muted">
        <a href={WORKFLOW} rel="noopener">{lang === 'ru' ? 'Посмотреть, как собираются релизы' : 'See how releases are built'}</a>
      </p>
    </div>
  </div>
</section>

<section>
  <div class="wrap narrow">
    <h2 class="reveal">{c.faqTitle}</h2>
    {c.faq.map(([q, a]) => (
      <details class="faq reveal">
        <summary>{q}</summary>
        <p set:html={link(a)} />
      </details>
    ))}
  </div>
</section>

<div class="marquee" aria-hidden="true">
  <div class="marquee-track">
    {[0, 1].map(() => (
      <div class="marquee-run">
        {marquee.map(([name, n]) => (
          <span class="marquee-item"><b>{nf.format(n)}</b>{name}</span>
        ))}
      </div>
    ))}
  </div>
</div>

<section class="final">
  <div class="wrap">
    <div class="final-box reveal">
      <span class="final-sweep" aria-hidden="true"></span>
      <img class="final-icon" src="/icon.png" width="84" height="84" alt="" />
      <h2>{c.ctaTitle}</h2>
      <p class="lead">{c.ctaLead}</p>
      <div class="btn-row">
        <Download copy={c} big />
      </div>
      <p class="muted">{c.ctaMeta}</p>
    </div>

    <div class="links">
      <a class="link-card reveal" href={GITHUB} rel="noopener">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.8 0-1.3.5-2.3 1.2-3.2-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.4 11.4 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.6 1.6.2 2.8.1 3.1.8.9 1.2 1.9 1.2 3.2 0 4.6-2.7 5.5-5.3 5.8.4.4.8 1.1.8 2.2v3.3c0 .4.2.7.8.6 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5z" />
        </svg>
        <span><b>{c.linkGithub[0]}</b>{c.linkGithub[1]}</span>
        <i class="arr">&#8594;</i>
      </a>
      <a class="link-card reveal" href={DISCORD} rel="noopener">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.3 4.4A19.8 19.8 0 0 0 15.4 3l-.2.4c1.6.4 2.9 1 4.1 1.8a13.8 13.8 0 0 0-9.8-.9c-.6.2-1.1.3-1.6.5.2-.1.3-.2.4-.2A16 16 0 0 1 12 3.4L11.8 3a19.8 19.8 0 0 0-4.9 1.4C3.8 8.9 3 13.3 3.4 17.6a19.9 19.9 0 0 0 6 3l1.2-1.7c-.9-.3-1.7-.7-2.5-1.3l.5-.4a14.2 14.2 0 0 0 12.1 0l.5.4c-.8.6-1.6 1-2.5 1.3l1.2 1.7c2.2-.7 4.2-1.7 6-3 .5-5-.8-9.3-3.6-13.2zM9.3 15c-1.2 0-2.1-1.1-2.1-2.4 0-1.3.9-2.4 2.1-2.4 1.2 0 2.2 1.1 2.2 2.4 0 1.3-1 2.4-2.2 2.4zm5.4 0c-1.2 0-2.1-1.1-2.1-2.4 0-1.3.9-2.4 2.1-2.4 1.2 0 2.2 1.1 2.2 2.4 0 1.3-1 2.4-2.2 2.4z" />
        </svg>
        <span><b>{c.linkDiscord[0]}</b>{c.linkDiscord[1]}</span>
        <i class="arr">&#8594;</i>
      </a>
    </div>
  </div>
</section>

<Hunt complete={c.huntComplete} shared={c.huntShared} />

<script>
  // A radial gradient placed by a custom property only knows the box it is painted in, so
  // every lit surface is told where the pointer is in its own coordinates.
  //
  // The rule that keeps this cheap: read everything, then write everything, once per frame.
  // Measuring a card inside the move handler is a forced reflow, and doing it for ten cards
  // on every pointer event is the usual reason a glow like this makes a page feel heavy. So
  // scroll and resize only mark the measurements stale, and the next frame that actually
  // paints takes them all in one go.
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const lit = [...document.querySelectorAll<HTMLElement>('.lit')];

  if (fine && lit.length) {
    const rects = new WeakMap<HTMLElement, DOMRect>();
    let stale = true;
    let ev: PointerEvent | null = null;
    let queued = false;

    const place = () => {
      queued = false;
      if (!ev) return;
      if (stale) {
        for (const el of lit) rects.set(el, el.getBoundingClientRect());
        stale = false;
      }
      for (const el of lit) {
        const box = rects.get(el);
        if (!box) continue;
        el.style.setProperty('--mx', `${ev.clientX - box.left}px`);
        el.style.setProperty('--my', `${ev.clientY - box.top}px`);
      }
    };

    for (const group of document.querySelectorAll<HTMLElement>('.lit-group')) {
      group.addEventListener('pointermove', (e) => {
        ev = e;
        if (!queued) { queued = true; requestAnimationFrame(place); }
      }, { passive: true });
    }
    const invalidate = () => { stale = true; };
    window.addEventListener('scroll', invalidate, { passive: true });
    window.addEventListener('resize', invalidate, { passive: true });
  }
</script>

<script>
  // A second door, for people who open the source of a page before they open the page.
  //
  // This is a GPL-3.0 project with a public repository, so a fair share of the people who
  // land here will look. The console gets the repository link and a working handle on the
  // thing the site is actually built out of: the eight hero palettes the app wears. Not a
  // joke printed in a box - the same gesture as clicking the mascot, in the place these
  // particular visitors live. The palette is read off the hunt's own data, so there is one
  // list of heroes on this site rather than two that drift apart.
  //
  // Deliberately absent: anything that gives away where the mascots are. Somebody who wants
  // to skip the hunt can already read this file.
  const heroes = JSON.parse(document.getElementById('hunt')?.dataset.heroes ?? '[]') as Array<{ id: string; primary: string }>;
  if (heroes.length) {
    console.log(
      '%c Dota 2 Mod Manager ',
      'background:#d0bcff;color:#220a32;padding:4px 10px;border-radius:6px;font-weight:700',
    );
    console.log('GPL-3.0, every line: https://github.com/dota2modmanager/dota2-mod-manager');
    console.log('The app wears eight hero palettes. So does this page: mm.hero("brew")');
    (window as any).mm = {
      palettes: Object.fromEntries(heroes.map((h) => [h.id, h.primary])),
      hero(name: string) {
        const h = heroes.find((x) => x.id === name);
        if (!h) return `no palette called "${name}". try: ${heroes.map((x) => x.id).join(', ')}`;
        document.documentElement.style.setProperty('--primary', h.primary);
        return h.id;
      },
    };
  }
</script>

<script>
  // The big numbers climb to themselves, once.
  //
  // The markup already holds the real, formatted figure - the climb replaces it for a second
  // and then puts that exact string back. So find-on-page, text selection and a screen reader
  // never see a frame of the animation, and somebody who asked for less motion never sees the
  // animation at all: they already have the number.
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const climbers = document.querySelectorAll<HTMLElement>('[data-to]');

  if (!still && climbers.length) {
    const nf = new Intl.NumberFormat(document.documentElement.lang || 'en');
    const io = new IntersectionObserver((entries) => {
      for (const en of entries) {
        if (!en.isIntersecting) continue;
        io.unobserve(en.target);
        const el = en.target as HTMLElement;
        const to = Number(el.dataset.to);
        const final = el.dataset.final ?? el.textContent ?? '';
        // Count in the shape the final number is written in. "1150" is authored without a
        // separator and "17,515" with one, so a blanket Intl.format would count up through
        // "1,149" and then snap to "1150" on the last frame - a visible twitch at exactly the
        // moment the eye is on it.
        const grouped = /\d\D\d/.test(final);
        const show = (v: number) => (grouped ? nf.format(v) : String(v));
        const t0 = performance.now();
        const step = (t: number) => {
          const k = Math.min(1, (t - t0) / 1100);
          // out-quart: most of the distance early, then a long settle - a climb that slows
          // down reads as arriving somewhere, a linear one reads as a loading bar
          el.textContent = k < 1 ? show(Math.round(to * (1 - (1 - k) ** 4))) : final;
          if (k < 1) requestAnimationFrame(step);
        };
        el.textContent = show(0);
        requestAnimationFrame(step);
      }
    }, { threshold: 0.45 });
    climbers.forEach((el) => io.observe(el));
  }
</script>
