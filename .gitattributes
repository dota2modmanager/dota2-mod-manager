# Line endings, decided once here instead of per machine.
#
# This is developed on Windows and built on Linux runners, and every text file is stored with
# LF in the repository. Without this file that only holds while each contributor happens to have
# core.autocrlf set the way the last one did; with it, a checkout on any machine produces the
# same bytes and nobody opens a pull request that changes every line of a file they edited two
# characters of.
* text=auto

# Read verbatim by tools that are not git. makepkg is a shell script and the AUR takes these
# files as they are, so a CR at the end of a line is a syntax error somebody has to debug.
packaging/aur/PKGBUILD text eol=lf
packaging/aur/.SRCINFO text eol=lf
*.sh text eol=lf

# Signed, and the signature is over the bytes git publishes rather than the bytes on the machine
# that made it. Left to text=auto this file is CRLF in a Windows working tree and LF in the
# repository, so it was signed at 1014 bytes and served at 999 and verified nowhere. Forcing LF
# here makes what you sign and what everyone downloads the same thing.
config/app.json text eol=lf
config/app.json.sig text eol=lf
config/presets.json text eol=lf
config/presets.json.sig text eol=lf

# Anything below is bytes, not lines. Git guesses this correctly most of the time; the guess is
# wrong exactly once, and the cost of it being wrong is a corrupted icon in a release.
*.png binary
*.jpg binary
*.webp binary
*.ico binary
*.icns binary
*.mp4 binary
*.webm binary
*.woff binary
*.woff2 binary
*.ttf binary
*.vpk binary
*.zip binary
*.exe binary
*.AppImage binary
