<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the bundle's own Info.plist by tauri-bundler. The scheme is what lets a
     d2mm://preset/ or d2mm://mod/ link open this app from a browser or another program;
     on Windows the installer's registry entry does the same, and on Linux the .desktop file
     (crates/mm-core/src/catalog/deep_links.rs). The .d2mm document type comes from
     tauri.conf.json's fileAssociations. -->
<plist version="1.0">
<dict>
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>com.dota2modmanager.app.preset</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>d2mm</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
