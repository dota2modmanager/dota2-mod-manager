{
  "name": "dota2-mod-manager",
  "productName": "Dota 2 Mod Manager",
  "version": "4.2.0",
  "desktopName": "dota2-mod-manager.desktop",
  "description": "Mod manager and modding toolkit for Dota 2: a catalog of 1000+ mods, an item builder with a 3D preview, and a Workshop of editors for effects, the HUD, the map and sounds",
  "scripts": {
    "start": "npm run build:app && cargo run -p dota2-mod-manager",
    "build:app": "node tools/dev/ui-build.mjs && cargo build -p dota2-mod-manager",
    "test": "node --import ./test/helpers/tmp-cleanup.mjs --test \"test/**/*.test.js\" \"test/**/*.test.ts\"",
    "lint": "eslint .",
    "typecheck": "node tools/dev/typecheck.mjs",
    "verify": "npm run lint && npm run typecheck && npm test",
    "sandbox:seed": "node tools/dev/sandbox.js seed",
    "sandbox:reset": "node tools/dev/sandbox.js reset",
    "sandbox:status": "node tools/dev/sandbox.js status",
    "dota:diff": "node tools/mods/dota-diff.mjs",
    "dota:bench": "node tools/mods/dota-bench.mjs",
    "doctor": "node tools/mods/mod-doctor.mjs",
    "item-plan": "node tools/mods/item-plan.mjs",
    "recolor": "node tools/mods/recolor.mjs",
    "tower-looks": "node tools/mods/tower-looks.mjs",
    "trees": "node tools/mods/trees.mjs",
    "fuzz": "node tools/dev/fuzz-parsers.mjs",
    "rollback": "node tools/release/rollback.mjs",
    "docs": "node tools/dev/gen-doc-facts.js && node tools/dev/gen-incidents.js",
    "aur": "node tools/release/gen-aur.js",
    "modkit": "node tools/mods/modkit.mjs",
    "dist": "tauri build",
    "start:sandbox": "node tools/dev/sandbox.js pin && npm run build:app && cargo run -p dota2-mod-manager -- --user-data-dir=sandbox/userdata --write-jail=sandbox",
    "e2e": "npm run build:app && node tools/dev/e2e.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dota2modmanager/dota2-mod-manager.git"
  },
  "author": "TheFleece",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/dota2modmanager/dota2-mod-manager",
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "adm-zip": "^0.6.1",
    "dota-loadout": "file:vendor/dota-loadout",
    "eslint": "^10.14.0",
    "fast-check": "^4.10.2",
    "meshoptimizer": "^1.3.0",
    "motion": "^14.13.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.5"
  }
}
